{
  "expo": {
    "name": "Status Saver for WhatsApp",
    "slug": "status-saver",
    "version": "1.0.0",
    "scheme": "statussaver",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#25D366"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.statussaver.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Save WhatsApp statuses to your gallery.",
        "NSPhotoLibraryAddUsageDescription": "Save WhatsApp statuses to your gallery."
      }
    },
    "android": {
      "package": "com.statussaver.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#25D366"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "requestLegacyExternalStorage": true,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Status Saver to save statuses to your gallery.",
          "savePhotosPermission": "Allow Status Saver to save statuses to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8f289623-02bd-487f-ab6c-717e6bcecea5"
      }
    }
  }
}
